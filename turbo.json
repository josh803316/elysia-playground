{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ],
      "env": [
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "CLERK_JWT_KEY",
        "CLERK_FRONTEND_API",
        "ADMIN_API_KEY",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "DATABASE_URL"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "VITE_API_URL"
      ]
    },
    "lint": {}
  },
  "globalEnv": [
    "NODE_ENV",
    "DIRECT_URL",
    "DATABASE_URL"
  ]
}