{
  "name": "@josh803316/svelte-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "VITE_APP_NAME='Svelte Client' vite dev",
    "prebuild": "svelte-kit sync",
    "build": "vite build && bun -e \"import { existsSync } from 'fs'; if (!existsSync('build/index.html')) { throw new Error('svelte/build/index.html missing after vite build') }\"",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pretest": "svelte-kit sync",
    "test": "vitest run",
    "storybook": "bunx storybook@latest dev -p 6008",
    "storybook:build": "bunx storybook@latest build",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN_SVELTE --exit-zero-on-changes --storybook-build-dir=storybook-static"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@github-ui/storybook-addon-performance-panel": "^1.2.0",
    "@neoconfetti/svelte": "^2.2.2",
    "@storybook/sveltekit": "10.6.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.5.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@clerk/shared": "4.31.0",
    "@elysia/eden": "2.0.0-beta.5",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "postcss": "^8.5.28",
    "svelte-clerk": "^1.1.15",
    "tailwindcss": "^4.3.3"
  }
}
