{
  "name": "@josh803316/svelte-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "VITE_APP_NAME='Svelte Client' vite dev",
    "prebuild": "svelte-kit sync",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pretest": "svelte-kit sync",
    "test": "vitest run",
    "storybook": "bunx storybook@latest dev -p 6008",
    "storybook:build": "bunx storybook@latest build",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN_SVELTE --exit-zero-on-changes --storybook-build-dir=storybook-static"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.2.7",
    "@github-ui/storybook-addon-performance-panel": "^1.1.4",
    "@neoconfetti/svelte": "^2.2.2",
    "@storybook/sveltekit": "10.2.15",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "svelte": "^5.53.5",
    "svelte-check": "^4.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.8",
    "flowbite": "^4.0.1",
    "flowbite-svelte": "^1.31.0",
    "flowbite-svelte-icons": "^3.1.0",
    "postcss": "^8.5.6",
    "svelte-clerk": "^0.20.5",
    "tailwindcss": "^4.2.1"
  }
}
