# E2E tests – copy to .env and set values

# Base URL of the running app (server + built frontends)
E2E_BASE_URL=http://localhost:3000

# Clerk – required for testing token and programmatic sign-in (use same keys as server/Dashboard)
CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# Clerk test user (create in Dashboard → Users; enable Email + Password for this user)
# To avoid "new device" email verification, use a test email: yourname+clerk_test@yourdomain.com
# Then any OTP/email code step can use the fixed code: 424242 (no real email is sent)
CLERK_TEST_EMAIL=your-e2e-test-user@example.com
CLERK_TEST_PASSWORD=your-secure-password

# Admin API key (for cleanup step – same key used in app “Admin Login”)
E2E_ADMIN_API_KEY=your-admin-api-key
