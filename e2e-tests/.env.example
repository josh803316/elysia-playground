# E2E tests – copy to .env and set values

# Base URL of the running app (server + built frontends)
E2E_BASE_URL=http://localhost:3500

# Clerk – required for testing token and programmatic sign-in (use same keys as server/Dashboard)
CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# Clerk test user – sign-in uses email_code strategy (no password needed by tests).
# Use a +clerk_test address (e.g. you+clerk_test@example.com) so no real email is
# sent; any OTP step accepts the fixed code 424242 in Clerk's test mode.
CLERK_TEST_EMAIL=your-e2e-test-user+clerk_test@example.com

# Admin API key (for cleanup step – same key used in app “Admin Login”)
E2E_ADMIN_API_KEY=your-admin-api-key
