{
  "name": "@josh803316/angular-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "storybook": "echo 'Angular Storybook is disabled (Storybook compiler incompatibility).' && exit 0",
    "storybook:build": "echo 'Angular Storybook is disabled.' && exit 0",
    "chromatic": "echo 'Angular Chromatic is disabled.' && exit 0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "bun@1.3.11",
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@github-ui/storybook-addon-performance-panel": "^1.1.4",
    "@storybook/angular": "10.3.3",
    "jsdom": "^29.0.1",
    "typescript": "~5.8.0",
    "vitest": "^4.1.8",
    "eslint-plugin-storybook": "10.3.3"
  }
}
