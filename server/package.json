{
  "name": "@josh803316/elysia-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@electric-sql/pglite": "^0.5.8",
    "@elysia/cors": "2.0.0-beta.1",
    "@elysia/eden": "2.0.0-beta.5",
    "@elysia/html": "2.0.0-beta.1",
    "@elysia/openapi": "2.0.0-beta.4",
    "@elysia/opentelemetry": "2.0.0-beta.1",
    "@elysia/static": "2.0.0-beta.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "2.0.0-beta.12",
    "exact-mirror": "^1.2.4",
    "jsonwebtoken": "^9.0.3",
    "openapi-types": "^12.1.3",
    "typebox": "^1.3.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "supabase": "^2.116.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.10"
  },
  "module": "src/index.js"
}
