{
  "name": "elysia-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "react",
    "svelte",
    "server",
    "htmx",
    "vanilla-js",
    "angular",
    "vue"
  ],
  "scripts": {
    "dev": "bun run dev:all",
    "dev:all": "turbo run dev --filter=./react --filter=./svelte --filter=./server",
    "dev:react": "turbo run dev --filter=./react --filter=./server",
    "dev:svelte": "turbo run dev --filter=./svelte --filter=./server",
    "dev:htmx": "turbo run dev --filter=./htmx --filter=./server",
    "dev:vanilla-js": "turbo run dev --filter=./vanilla-js --filter=./server",
    "dev:comparison": "turbo run dev --filter=./react --filter=./svelte --filter=./server",
    "build": "turbo run build",
    "build:react": "turbo run build --filter=./react",
    "build:svelte": "turbo run build --filter=./svelte",
    "build:vue": "cd vue && bun run build",
    "dev:vue": "turbo run dev --filter=./vue --filter=./server",
    "install:vue": "cd vue && bun install",
    "build:frontends": "bun run build:react && bun run build:svelte && bun run build:angular && bun run build:vue",
    "dev:monolith": "bun run build:react && bun run build:svelte && bun run build:angular && bun run build:vue && bun run dev:server",
    "typecheck:react": "cd react && bun run typecheck",
    "test": "turbo run test",
    "test:htmx": "cd server && NODE_ENV=test USE_PGLITE=true bun test src/controllers/htmx.controller.test.ts",
    "lint": "turbo run lint",
    "install:all": "bun install && bun run install:workspaces",
    "install:workspaces": "bun run install:react && bun run install:svelte && bun run install:server && bun run install:htmx && bun run install:vanilla-js && bun run install:angular",
    "install:react": "cd react && bun install",
    "install:svelte": "cd svelte && bun install",
    "install:server": "cd server && bun install",
    "install:htmx": "cd htmx && bun install",
    "install:vanilla-js": "cd vanilla-js && bun install",
    "install:angular": "cd angular && bun install",
    "dev:angular": "turbo run dev --filter=./angular --filter=./server",
    "build:angular": "cd angular && bun run build",
    "dev:server": "cd server && bun run dev",
    "build:server": "bun run build -w server",
    "start:server": "bun run start -w server",
    "test:server": "bun test --bun server",
    "db:generate": "cd server && bun run db:generate",
    "db:migrate": "cd server && bun run db:migrate",
    "db:migrate:local": "cd server && bun run db:migrate:local",
    "db:studio": "cd server && bun run db:studio",
    "db:seed": "cd server && bun run db:seed",
    "e2e": "cd e2e-tests && bun run e2e",
    "e2e:ui": "cd e2e-tests && bun run e2e:ui"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "@clerk/backend": "2.29.2"
  },
  "dependencies": {
    "elysia": "^1.4.25"
  },
  "devDependencies": {
    "bun-types": "latest",
    "turbo": "^2.8.10"
  },
  "patchedDependencies": {
    "@clerk/backend@2.29.2": "patches/@clerk%2Fbackend@2.29.2.patch"
  }
}
